@{
    ViewData["Title"] = "OSM Connectivity Tool";
}
<!DOCTYPE html>
<html>
<head>
    <title>Data Layer: Polygon</title>
    <meta name="viewport" content="initial-scale=1.0">
    <meta charset="utf-8">
    <style>
        /* Always set the map height explicitly to define the size of the div
        * element that contains the map. */
        #map {
            height: 100%;
        }
        /* Optional: Makes the sample page fill the window. */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        #legend {
            font-family: Arial, sans-serif;
            background: #fff;
            padding: 10px;
            margin: 10px;
            border: 3px solid #000;
        }

        .sidenav {
            width: 300px;
            height: 600px;
            margin-top: 40px;
            position: fixed;
            z-index: 1;
            top: 20px;
            left: 10px;
            overflow-x: hidden;
            padding: 8px 0;
        }

        .sidenav button {
            padding: 6px 8px 6px 16px;
            text-decoration: none;
            font-size: 13px;
            color: #2196F3;
            display: block;
        }
    </style>
</head>
<body>
    <div class="sidenav">
        <div class="btn-group-vertical dropright">
            <button type="button" class="btn btn-secondary" onclick="changeCenter(-41.270634, 173.283966)">Go to NZ</button>
            <button type="button" class="btn btn-secondary" onclick="changeCenter(-17.713371, 178.065033)">Go to FJ</button>
            <button type="button" class="btn btn-secondary" onclick="hideShowIncorrectConnections()">Hide/Show Incorrect Connections</button>
            <button type="button" class="btn btn-secondary" onclick="hideShowWhitelistNodes()">Hide/Show Whitelisted Nodes</button>
            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenu2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                OSM Connectivity Tool
                <span class="caret"></span>
            </button>
            <div class="dropdown-menu" aria-labelledby="dropdownMenu2">
                <div class="btn-group-vertical">
                    <button type="button" class="btn btn-secondary" onclick="drawPrimary()">Hide/Draw Primary Routes</button>
                    <button type="button" class="btn btn-secondary" onclick="drawSecondary()">Hide/Draw Secondary Routes</button>
                    <button type="button" class="btn btn-secondary" onclick="drawFerryRoutes()">Hide/Draw Ferry Routes</button>
                    <button type="button" class="btn btn-secondary" onclick="drawMotorwayGraph()">Hide/Draw Motorway Graph</button>
                    <button type="button" class="btn btn-secondary" onclick="drawTrunkGraph()">Hide/Draw Trunk Graph</button>
                    <button type="button" class="btn btn-secondary" onclick="drawDisconnections()">Hide/Show Disconnections</button>
                    <button type="button" class="btn btn-secondary" onclick="download()">Download Report</button>
                    <button type="button" class="btn btn-secondary" onclick="drawTrunkTrunkLinkDemoConnectivity()">Hide/Demo T/TL Connectivity</button>
                    <button type="button" class="btn btn-secondary rounded-lg" onclick="drawTrunkTrunkLinkPrimaryDemoConnectivity()">Hide/Demo T/TL/P/PL Connectivity</button>
                    <button type="button" class="btn btn-secondary rounded-lg" onclick="demoPrimarViaSecondary()">Hide/Demo Primary Connectivity via Secondary</button>
                    <button type="button" class="btn btn-secondary rounded-lg" onclick="demoPSConnectivityViaST()">Hide/Demo P/S connectivity via S/T</button>
                </div>
            </div>
        </div>
    </div>

    <div id="map"></div>
    <div id="legend">
        <h3>Legend</h3>
        <img src="~/Content/images/black.png" width="50" height="8"> Motorway </img>
        <br />
        <img src="~/Content/images/red.png" width="50" height="8"> Trunk </img>
        <br />
        <img src="~/Content/images/darkBlue.png" width="50" height="8"> Ferry </img>
        <br />
        <img src="~/Content/images/F39C12.png" width="50" height="8"> Primary </img>
        <br />
        <img src="~/Content/images/27AE60.png" width="50" height="8"> Secondary </img>
        <br />
        <img src="~/Content/images/pin.png" width="45" height="50"> Incompatible Connection </img>
        <br />
        <img src="~/Content/images/blue-pin.png" width="45" height="50"> Whitelist Nodes </img>
    </div>

    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyC2BmtjwtFmGF_Dh-J8ltarifOtyrRYd7w&callback=initMap"></script>
    <script src="~/Scripts/jquery-3.3.1.js"></script>
    <script type="text/javascript">

