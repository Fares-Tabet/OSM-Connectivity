        var log = ''
        function download() {

            @using Newtonsoft.Json;
            var json = @Html.Raw(JsonConvert.SerializeObject(ViewBag.demoTrunkTrunkLinkConnectivity));
            var filename = "NZ_TrunkTrunkLink_MotorwayConnectivityFix.json";
            var dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(json));
            //creating an invisible element
            var element = document.createElement('a');
            element.setAttribute('href', dataStr);

            element.setAttribute('download', filename);

            document.body.appendChild(element);

            //onClick property
            element.click();

            document.body.removeChild(element);
            @using Newtonsoft.Json;
            var json = @Html.Raw(JsonConvert.SerializeObject(ViewBag.demoTrunkTrunkLinkPrimaryConnectivity));
            var filename = "NZ_TrunkTrunkLinkPrimary_MotorwayConnectivityFix.json";
            var dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(json));
            //creating an invisible element
            var element = document.createElement('a');
            element.setAttribute('href', dataStr);

            element.setAttribute('download', filename);

            document.body.appendChild(element);

            //onClick property
            element.click();

            document.body.removeChild(element);
        }


        function highlightIncorrectConnections(flag) {

            var json;

            $.ajax({
                url: "Fiji/getIncorrectConnectionsData",
                method: "GET",
                success: function (data) {
                    data = JSON.parse(data);
                    json = data;
                },
                error: function (err) {
                    console.log(err)
                },
                async:false
            });

            var count = Object.keys(json).length;

            for (var i = 0; i < count; i++) {

                // Add a marker pin of each disconnection on the map
                if (flag == 1) {
                    var marker = new google.maps.Marker({
                        map: map,
                        //icon: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png',
                        animation: google.maps.Animation.DROP,

                        position: { lat: json[i]['Lat'], lng: json[i]['Lng'] },
                        clickable: true,
