        /*
        Build list of map types.
        You can also use var mapTypeIds = ["roadmap", "satellite", "hybrid", "terrain", "OSM"]
        but static lists suck when Google updates the default list of map types.
        */
        var mapTypeIds = [];
        for (var type in google.maps.MapTypeId) {
            mapTypeIds.push(google.maps.MapTypeId[type]);
        }
        mapTypeIds.push("OSM");

        var map = new google.maps.Map(element, {
            center: new google.maps.LatLng(-17.713371, 178.065033),
            zoom: 6,
            mapTypeId: "OSM",
            mapTypeControlOptions: {
                mapTypeIds: mapTypeIds
            }
        });

        map.mapTypes.set("OSM", new google.maps.ImageMapType({
            getTileUrl: function (coord, zoom) {
                // See above example if you need smooth wrapping at 180th meridian
                return "https://tile.openstreetmap.org/" + zoom + "/" + coord.x + "/" + coord.y + ".png";
            },
            tileSize: new google.maps.Size(256, 256),
            name: "OpenStreetMap",
            maxZoom: 18
        }));

        loadWhiteListMarkers();
        highlightIncorrectConnections(1);

        function createInfoWindow(poly, content) {
            var infowindow = new google.maps.InfoWindow();
            google.maps.event.addListener(poly, 'click', function (event) {
                infowindow.setContent(content);
                infowindow.setPosition(event.latLng);
                infowindow.open(map);
            });

            google.maps.event.addListener(poly, 'mouseover', function (event) {
                infowindow.setPosition(event.latLng);
                infowindow.setContent("You are at " + event.latLng);
                infowindow.open(map);
            });

            // Close the InfoWindow on mouseout:
            google.maps.event.addListener(poly, 'mouseout', function () {
                infowindow.close();
            });
        }

        // Draw the primary routes
        function drawPrimary() {
            @using Newtonsoft.Json;
            var json = @Html.Raw(JsonConvert.SerializeObject(ViewBag.FJ_Primary));
            var count = Object.keys(json).length;
            var flightPath = null;

            for (var i = 0; i < count; i++) {

                var data = [];
                var ptsCount = Object.keys(json[i]['nodes']).length;

                for (var j = 0; j < ptsCount; j++) {
                    data.push({ lat: json[i]['nodes'][j]['Lat'], lng: json[i]['nodes'][j]['Lng'] });
                }
                var flightPath = new google.maps.Polyline({
                    path: data,
                    geodesic: true,
                    strokeColor: '#F39C12',
                    strokeOpacity: 1.0,
                    strokeWeight: 2
                });
                //if (document.getElementById('primary').checked) {
                //    createInfoWindow(flightPath, 'infowindow...test');
                //}
                primaryLine.push(flightPath);
            }
            if (document.getElementById('primary').checked) {
                for (i = 0; i < primaryLine.length; i++) {
                    primaryLine[i].setMap(map);
                }
            } else {
                for (i = 0; i < primaryLine.length; i++) {
                    primaryLine[i].setMap(null);
                }
            }
        }

        // Draw the ferry terminals
        function drawFerryTerminals() {
            @using Newtonsoft.Json;
            var json = @Html.Raw(JsonConvert.SerializeObject(ViewBag.ferryTerminals));
            var icon = {
                url: "http://maps.google.com/mapfiles/kml/shapes/ferry.png", // url
                scaledSize: new google.maps.Size(20, 20), // scaled size
            };
            var count = Object.keys(json).length;
            for (var i = 0; i < count; i++) {
                var marker = new google.maps.Marker({
                    map: map,
                    icon: icon,
                    animation: google.maps.Animation.DROP,
                    position: { lat: json[i]['Lat'], lng: json[i]['Lng'] },
                    title: json[i]['Id']
                });
                ferryTerminalsMakers.push(marker);
            }

            if (!undrawFerryTerminals) {
                for (var i = 0; i < ferryTerminalsMakers.length; i++) {
                    ferryTerminalsMakers[i].setMap(map);
                }
                undrawFerryTerminals = true;
            } else {
                for (var i = 0; i < ferryTerminalsMakers.length; i++) {
                    this.ferryTerminalsMakers[i].setMap(null);
                }
                this.ferryTerminalsMakers = new Array();
                undrawFerryTerminals = false;
            }
        }

