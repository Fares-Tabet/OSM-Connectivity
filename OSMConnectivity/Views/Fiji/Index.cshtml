@{
    ViewData["Title"] = "Fiji";
}
<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://wagtrung.github.io/store/themify-icons/themify-icons.css">

    <title>Data Layer: Polygon</title>
    <meta name="viewport" content="initial-scale=1.0">
    <meta charset="utf-8">
    <style>
        /* Always set the map height explicitly to define the size of the div
        * element that contains the map. */
        body {
            overflow-y: scroll;
            font-family: sans-serif;
            background-color: #fefefe;
        }

        #map {
            height: 100%;
        }

        /* Optional: Makes the sample page fill the window. */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        #legend {
            font-family: Arial, sans-serif;
            background: #fff;
            padding: 10px;
            margin: 10px;
            border: 3px solid #000;
            border-radius: 3px;
        }


        .category {
            position: absolute;
            width: 17em;
            margin-top: 60px;
            margin-left: 11px;
            height: 270px;
            top: 0;
            background: #fff;
            font-size: 1.6rem;
            border-radius: 3px;
        }

        .ctghead {
            padding: 2px 40px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.09);
        }

            .ctghead h3 {
                display: inline-flex;
                align-items: center;
                font-size: 1.3rem;
                font-weight: 700;
            }

                .ctghead h3 i {
                    font-size: 2.5rem;
                    margin-right: 7px;
                }

        .ctgul {
            margin-top: 16px;
            padding: 0 0 16px 0;
        }

        .ctgulChild {
            margin: 0 0 0 30px;
            padding: 0 0 10px 0;
        }

        .ctgliChild {
            font-size: 1.2rem;
            display: block;
            position: relative;
            list-style: none;
            transition: .3s linear;
            box-shadow: transparent 0px 14px 13px -12px, transparent 0px 26px 32px -22px;
        }

        .ctgli:hover {
            border-left: 4px solid var(--hove);
            background: #d2ffe221;
            box-shadow: rgba(50, 50, 93, 0.08) 0px 14px 13px -12px, rgba(0, 0, 0, 0.16) 0px 26px 32px -22px;
        }

        .ctga, .ctgaChild {
            width: 100%;
            display: inline-flex;
            align-items: center;
            cursor: pointer;
            color: #333;
            text-decoration: none;
            padding: 13px 40px 13px 34px;
            position: relative;
            right: 0;
            transition: right linear .3s;
        }

            .ctga i {
                margin-right: 10px;
            }

        .ctgaChild {
            padding: 13px 13px 13px 36px;
        }

            .ctga:hover, .ctgaChild:hover {
                right: -4px;
                color: var(--hove);
                text-decoration: none;
            }

            ctga:active, ctgaChild:active, ctga:visited, ctgaChild:visited, ctga:focus, ctgaChild:focus {
                text-decoration: none;
            }

            .ctgaChild::before {
                top: 50%;
                transform: translateY(-50%);
                left: 20px;
                position: absolute;
                border-style: solid;
                border-color: transparent transparent transparent var(--hove);
                border-width: 4px;
                content: "";
            }

        .down {
            position: absolute;
            font-size: 1.3rem;
            right: 10%;
            top: 50%;
            transform: translateY(-50%) rotate(360deg);
        }

        .ctgulChild {
            display: none;
            text-decoration: none;
        }

        .ctgli {
            display: block;
            position: relative;
            list-style: none;
            border-left: 4px solid transparent;
            transition: .3s linear;
        }

        :root {
            --white: #fff;
            --black: #000;
            --textColor: #333;
            --hove: #04ca88;
        }

        label {
            font-weight: 100;
            font-size: smaller;
            margin-bottom: 0;
            text-decoration: none;
        }

        label:active, label:visited, labe:focus {
            text-decoration: none;
        }

        input[type="checkbox"] {
            vertical-align: middle;
        }

        input[type="radio"], input[type="checkbox"] {
            margin: -2px 0 0;
            line-height: normal;
        }

    </style>
</head>
