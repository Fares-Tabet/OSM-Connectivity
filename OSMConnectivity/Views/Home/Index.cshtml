@{
    ViewData["Title"] = "Home Page";
}
<!DOCTYPE html>
<html>
<head>
    <title>Data Layer: Polygon</title>
    <meta name="viewport" content="initial-scale=1.0">
    <meta charset="utf-8">
    <style>


        /* Always set the map height explicitly to define the size of the div
        * element that contains the map. */
        #map {
            height: 100%;
        }
        /* Optional: Makes the sample page fill the window. */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        #legend {
            font-family: Arial, sans-serif;
            background: #fff;
            padding: 10px;
            margin: 10px;
            border: 3px solid #000;
        }

        #floating-side-panel {
            display: grid;
            background-color: #fff;
            left: 0.9%;
            padding: 5px;
            position: absolute;
            top: 70px;
            z-index: 5;
            border-radius: 2px;
            box-shadow: 2px 2px 1px rgba(0, 0, 0, 0.1);
        }

        #floating-top-panel {
            position: absolute;
            top: 10px;
            left: 25%;
            z-index: 5;
            background-color: #fff;
            padding: 5px;
            border: 1px solid #999;
            text-align: center;
            font-family: 'Roboto','sans-serif';
            line-height: 30px;
            padding-left: 10px;
        }

        .title {
            font-size: 18px;
            width: auto;
            height: auto;
            display: inline;
            vertical-align: middle;
            padding-right: 10px;
            padding-left: 10px;
        }
    </style>
</head>
<body>
    <div id="floating-top-panel">
        <input onclick="hideShowIncorrectConnections();" type=button value="Hide/Show Incorrect Connections">
        <input onclick="hideShowWhitelistNodes();" type=button value="Hide/Show Whitelisted Nodes">
    </div>
    <div id="floating-side-panel">
        <h1 class="title">OSM Connectivity Tool</h1>
        <button onclick="highlightIncorrectConnections(1)">Incorrect Connections</button>
        <button onclick="drawMotorwayGraph()">Draw Motorway Graph</button>
        <button onclick="drawTrunkGraph()">Draw Trunk Graph</button>
        <button onclick="drawDisconnections()">Disconnections</button>
        <button onclick="drawMaxSubTreeGraph()">Draw MaxSubTree Graph</button>
        <button onclick="download()">Download Report</button>
    </div>
    <div id="map"></div>
    <div id="legend">
        <h3>Legend</h3>
        <img src="~/Content/images/black.png" width="50" height="8"> Motorway </img>
        <br />
        <img src="~/Content/images/red.png" width="50" height="8"> Trunk </img>
        <br />
        <img src="~/Content/images/pin.png" width="45" height="50"> Incompatible Connection </img>
        <br />
        <img src="~/Content/images/blue-pin.png" width="45" height="50"> Whitelist Nodes </img>
    </div>

    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyC2BmtjwtFmGF_Dh-J8ltarifOtyrRYd7w&callback=initMap"></script>
    <script src="~/Scripts/jquery-3.3.1.js"></script>
    <script type="text/javascript">

        //Global variables:
        var incorrectMarkersDictionary = new Map();
        var whitlelistNodes = new Map();
        var markerGroups = {
            incorrectMarkersDictionary,
            whitlelistNodes
        };

        var element = document.getElementById("map");


        /*
        Build list of map types.
        You can also use var mapTypeIds = ["roadmap", "satellite", "hybrid", "terrain", "OSM"]
        but static lists suck when Google updates the default list of map types.
        */
        var mapTypeIds = [];
        for (var type in google.maps.MapTypeId) {
            mapTypeIds.push(google.maps.MapTypeId[type]);
        }
        mapTypeIds.push("OSM");


        var map = new google.maps.Map(element, {
            center: new google.maps.LatLng(-41.270634, 173.283966),
            zoom: 6,
            mapTypeId: "OSM",
            mapTypeControlOptions: {
                mapTypeIds: mapTypeIds
            }
        });


        map.mapTypes.set("OSM", new google.maps.ImageMapType({
            getTileUrl: function (coord, zoom) {
                // See above example if you need smooth wrapping at 180th meridian
                return "https://tile.openstreetmap.org/" + zoom + "/" + coord.x + "/" + coord.y + ".png";
            },
            tileSize: new google.maps.Size(256, 256),
            name: "OpenStreetMap",
            maxZoom: 18
        }));

        loadWhiteListMarkers();


        function drawMotorwayGraph() {

            @using Newtonsoft.Json;
            var json = @Html.Raw(JsonConvert.SerializeObject(ViewBag.motorways));
            var count = Object.keys(json).length;


            for (var i = 0; i < count; i++) {
                var data = [];
                var ptsCount = Object.keys(json[i]['nodes']).length;


            for (var j = 0; j < ptsCount; j++)
            {
                data.push({ lat: json[i]['nodes'][j]['Lat'], lng: json[i]['nodes'][j]['Lng'] });
            }

            var flightPath = new google.maps.Polyline({
            path: data,
            geodesic: true,
            strokeColor: '#001F3F',
            strokeOpacity: 1.0,
            strokeWeight: 2
             });

            flightPath.setMap(map);
            }

        }

        function drawMaxSubTreeGraph() {

            @using Newtonsoft.Json;
            var json = @Html.Raw(JsonConvert.SerializeObject(ViewBag.maxSubGraph));
            var count = Object.keys(json).length;


            for (var i = 0; i < count; i++) {
                var data = [];
                var ptsCount = Object.keys(json[i]['nodes']).length;


            for (var j = 0; j < ptsCount; j++)
            {
                data.push({ lat: json[i]['nodes'][j]['Lat'], lng: json[i]['nodes'][j]['Lng'] });
            }

            var flightPath = new google.maps.Polyline({
            path: data,
            geodesic: true,
            strokeColor: '#001F3F',
            strokeOpacity: 1.0,
            strokeWeight: 2
             });

            flightPath.setMap(map);
            }
        }

        function drawDisconnections() {

            @using Newtonsoft.Json;
            var json = @Html.Raw(JsonConvert.SerializeObject(ViewBag.disjointedSubTreeWays));
            var count = Object.keys(json).length;


            for (var i = 0; i < count; i++) {
                var data = [];
                var ptsCount = Object.keys(json[i]['nodes']).length;


            for (var j = 0; j < ptsCount; j++)
            {
                data.push({ lat: json[i]['nodes'][j]['Lat'], lng: json[i]['nodes'][j]['Lng'] });
            }

            var flightPath = new google.maps.Polyline({
            path: data,
            geodesic: true,
                strokeColor: json[i]['colorCode'],
            strokeOpacity: 1.0,
            strokeWeight: 2
             });

            flightPath.setMap(map);
            }

        }

        function drawTrunkGraph() {

            @using Newtonsoft.Json;
            var json = @Html.Raw(JsonConvert.SerializeObject(ViewBag.trunks));
            var count = Object.keys(json).length;

            for (var i = 0; i < count; i++) {
                var data = [];
                var ptsCount = Object.keys(json[i]['nodes']).length;


            for (var j = 0; j < ptsCount; j++)
            {
                data.push({ lat: json[i]['nodes'][j]['Lat'], lng: json[i]['nodes'][j]['Lng'] });
            }

            var flightPath = new google.maps.Polyline({
            path: data,
            geodesic: true,
                strokeColor: '#FF0000',
            strokeOpacity: 1.0,
            strokeWeight: 2
        });

            flightPath.setMap(map);

            }
        }

        var log = ''
        function download() {
            getMotorwarDisconnections(0)
            var text = log;
            var filename = "log.txt";
            //creating an invisible element
            var element = document.createElement('a');
            element.setAttribute('href', 'data:text/plain;charset=utf-8, '
                + encodeURIComponent(text));
            element.setAttribute('download', filename);

            document.body.appendChild(element);

            //onClick property
            element.click();

            document.body.removeChild(element);
        }


        function highlightIncorrectConnections(flag) {

            var json;

            $.ajax({
                url: "Home/getIncorrectConnectionsData",
                method: "GET",
                success: function (data) {
                    data = JSON.parse(data);
                    json = data;
                },
                error: function (err) {
                    console.log(err)
                },
                async:false
            });

            var count = Object.keys(json).length;

            for (var i = 0; i < count; i++) {

                // Add a marker pin of each disconnection on the map
                if (flag == 1) {
                    var marker = new google.maps.Marker({
                        map: map,
                        //icon: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png',
                        animation: google.maps.Animation.DROP,

                        position: { lat: json[i]['Lat'], lng: json[i]['Lng'] },
                        clickable: true,
                        title: json[i]['Id']

                    });
                }

                var disconnectionInfo = '';
                var NodeWayCount = json[i]['roads'].length;


                var motorwayString = '';
                var disconnectedWaysString = '';

                for (var j = 0; j < NodeWayCount; j++)
                {

                    if (json[i]['roads'][j]['roadClass'] != 'motorway' && json[i]['roads'][j]['roadClass'] != 'motorway_link')
                    {
                        disconnectedWaysString += json[i]['roads'][j]['roadClass'] + ' (' + json[i]['roads'][j]['Id'] + '), ';
                    }
                    else
                    {
                        motorwayString += json[i]['roads'][j]['Id'] + ', ';
                    }
                }

                motorwayString = motorwayString.slice(0, -2);

                if (NodeWayCount == 1) {
                    disconnectionInfo = '<div id="content">' +
                        '<div id="siteNotice">' +
                        '</div>' +
                        '<h2 id="firstHeading" class="firstHeading">Incorrect Connection</h2>' +
                        '<div id="bodyContent">' +
                        '<p style="width:250px"><a href="https://www.openstreetmap.org/node/' + json[i]['Id'] +
                        '" target="_blank" rel="noopener"><b>Node ' + json[i]['Id'] + '</a> connects a <a href="https://www.openstreetmap.org/way/' +
                        motorwayString +
                        '" target="_blank" rel="noopener">motorway ( ' + motorwayString +')</a> with another incompatible road type<br/><br/>' +

                        '<a href="https://www.openstreetmap.org/edit?node=' + json[i]['Id'] + '" target="_blank" rel="noopener">' +
                        'Open in OSM iD </a><br/><br/><button onclick = addToWhitelist('+json[i]['Id']+')> Whitelist </button>'+
                        '</div></div> ';

                    log = log +"Node " + json[i]['Id'] + "\nNode " + json[i]['Id'] + ' is a disconnection in the motorway: ' + motorwayString +
                        '\nFor more information and options go to: ' + 'https://www.openstreetmap.org/node/' + json[i]['Id'] + '\n\n\n';


                }// if there are 2 ways corresponding to the node, then one is motorway and the other is the disconnection
                else

                {
                    disconnectedWaysString = disconnectedWaysString.slice(0, -2);

                    disconnectionInfo = '<div id="content">' +
                        '<div id="siteNotice">' +
                        '</div>' +
                        '<h2 id="firstHeading" class="firstHeading">Incorrect Connection</h2>' +
                        '<div id="bodyContent">' +
                        '<p style="width:250px"><a href="https://www.openstreetmap.org/node/' + json[i]['Id'] +
                        '" target="_blank" rel="noopener"><b>Node ' + json[i]['Id'] + '</a> connects a motorway (' + motorwayString +
                        ')<br/> with incompatible ' + disconnectedWaysString + '<br/><br/>' +

                        '<a href="https://www.openstreetmap.org/edit?node=' + json[i]['Id'] + '" target="_blank" rel="noopener">' +
                        'Open in OSM iD </a><br/><br/><button onclick = addToWhitelist('+json[i]['Id']+')> Whitelist </button>' +
                        '</div></div> ';

                    log = log + "Node " + json[i]['Id']+ "\nNode " + json[i]['Id'] + ' is a disconnection in the motorway: ' + motorwayString +
                        '\nand Ways: ' + disconnectedWaysString +
                        '\nFor more information and options go to: ' + 'https://www.openstreetmap.org/node/' + json[i]['Id'] + '\n\n\n';
                }

                if (flag == 1) {
                    marker.info = new google.maps.InfoWindow({
                        content: disconnectionInfo
                    });

                    //adding the onclick listener event for each marker
                    google.maps.event.addListener(marker, 'click', function () {
                        var marker_map = this.getMap();
                        this.info.open(marker_map, this);
                    });
                }

                //add the markers to global variable incorrectMarkersDictionary
                markerGroups['incorrectMarkersDictionary'].set(json[i]['Id'],marker);
            }

        }

        function hideShowIncorrectConnections()
        {

            if (markerGroups['incorrectMarkersDictionary'].size > 0)
            {
                if (markerGroups['incorrectMarkersDictionary'].values().next().value.getVisible() == true) {
                    for (const [key, value] of markerGroups['incorrectMarkersDictionary'].entries()) {
                        value.setVisible(false);
                    }
                } else
                {
                    for (const [key, value] of markerGroups['incorrectMarkersDictionary'].entries()) {
                        value.setVisible(true);
                    }
                }
            }

        }


        function loadWhiteListMarkers() {

            var json;

            $.ajax({
                url: "Home/getWhiteListData",
                method: "GET",
                success: function (data) {
                    data = JSON.parse(data);
                    json = data;

                },
                error: function (err) {
                    console.log(err)
                },
                async:false

            });

            var count = Object.keys(json).length;

            for (var i = 0; i < count; i++) {

                // Add a marker pin of each disconnection on the map
                var marker = new google.maps.Marker({
                    map: map,
                    icon: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png',
                    animation: google.maps.Animation.DROP,

                    position: { lat: json[i]['Lat'], lng: json[i]['Lng'] },
                    clickable: true,
                    title: json[i]['Id']

                });

                marker.setVisible(false);

                var NodeWayCount = json[i]['roads'].length;

                var motorwayString = '';
                var disconnectedWaysString = '';

                for (var j = 0; j < NodeWayCount; j++) {

                    if (json[i]['roads'][j]['roadClass'] != 'motorway' && json[i]['roads'][j]['roadClass'] != 'motorway_link') {
                        disconnectedWaysString += json[i]['roads'][j]['roadClass'] + ' (' + json[i]['roads'][j]['Id'] + '), ';
                    }
                    else {
                        motorwayString += json[i]['roads'][j]['Id'] + ', ';
                    }
                }

                motorwayString = motorwayString.slice(0, -2);

                if (NodeWayCount == 1) {
                    disconnectionInfo = '<div id="content">' +
                        '<div id="siteNotice">' +
                        '</div>' +
                        '<h2 id="firstHeading" class="firstHeading">Incorrect Connection</h2>' +
                        '<div id="bodyContent">' +
                        '<p style="width:250px"><a href="https://www.openstreetmap.org/node/' + json[i]['Id'] +
                        '" target="_blank" rel="noopener"><b>Node ' + json[i]['Id'] + '</a> connects a <a href="https://www.openstreetmap.org/way/' +
                        motorwayString +
                        '" target="_blank" rel="noopener">motorway ( ' + motorwayString + ')</a> with another incompatible road type<br/><br/>' +
                        '<br /> <br /> <button onclick= removeFromWhitelist('+json[i]['Id']+')> Remove from Whitelist </button > '+
                        '</div></div> ';



                }// if there are 2 ways corresponding to the node, then one is motorway and the other is the disconnection
                else {
                    disconnectedWaysString = disconnectedWaysString.slice(0, -2);

                    disconnectionInfo = '<div id="content">' +
                        '<div id="siteNotice">' +
                        '</div>' +
                        '<h2 id="firstHeading" class="firstHeading">Incorrect Connection</h2>' +
                        '<div id="bodyContent">' +
                        '<p style="width:250px"><a href="https://www.openstreetmap.org/node/' + json[i]['Id'] +
                        '" target="_blank" rel="noopener"><b>Node ' + json[i]['Id'] + '</a> connects a motorway (' + motorwayString +
                        ')<br/> with incompatible ' + disconnectedWaysString + '<br/><br/>' +
                        '<br /> <br /> <button onclick= removeFromWhitelist(' + json[i]['Id'] + ')> Remove from Whitelist </button > '+
                        '</div></div> ';

                }
                marker.info = new google.maps.InfoWindow({
                    content: disconnectionInfo
                });

                //adding the onclick listener event for each marker
                google.maps.event.addListener(marker, 'click', function () {
                    var marker_map = this.getMap();
                    this.info.open(marker_map, this);
                });

                //add the markers to global variable incorrectMarkersDictionary
                markerGroups['whitlelistNodes'].set(json[i]['Id'], marker);
            }
        }

        //when a user clicks whitelist node
        function addToWhitelist(id)
        {
            //call controller function
            $.get("/Home/addToWhitelist",{id:id}, function (data) {
                alert(data);
            });

           //create whitelist node
            var whitelistMarker = new google.maps.Marker({
                        map: map,
                        icon: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png',
                        position: markerGroups['incorrectMarkersDictionary'].get(''+id).position ,
                clickable: true,
                title:''+id

            });
            //set visibility to false
            whitelistMarker.setVisible(false);
            //remove the node from all the layers and add it to whitelist layer
            markerGroups['incorrectMarkersDictionary'].get('' + id).setMap(null);
            markerGroups['incorrectMarkersDictionary'].delete('' + id);
            markerGroups['whitlelistNodes'].set('' + id, whitelistMarker);

        }

        //when a user wants to remove a node from the whitelist
        function removeFromWhitelist(id) {
            //call controller function
            $.get("/Home/removeFromWhitelist", { id: id }, function (data) {
                alert(data);
            });

            //create whitelist node
            var incorrectConnectionNode = new google.maps.Marker({
                map: map,
                //icon: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png',
                position: markerGroups['whitlelistNodes'].get('' + id).position,
                clickable: true,
                title: '' + id

            });

            //set visibility to false
            incorrectConnectionNode.setVisible(false);
            //remove the node from all the layers and add it to whitelist layer
            markerGroups['whitlelistNodes'].get('' + id).setMap(null);
            markerGroups['whitlelistNodes'].delete('' + id);
            markerGroups['incorrectMarkersDictionary'].set('' + id, incorrectConnectionNode);

        }

        function hideShowWhitelistNodes()
        {
            if (markerGroups['whitlelistNodes'].size > 0)
            {
                if (markerGroups['whitlelistNodes'].values().next().value.getVisible() == true) {
                    for (const [key, value] of markerGroups['whitlelistNodes'].entries()) {
                        value.setVisible(false);
                    }
                } else
                {
                    for (const [key, value] of markerGroups['whitlelistNodes'].entries()) {
                        value.setVisible(true);
                    }
                }
            }
        }


        map.controls[google.maps.ControlPosition.RIGHT_BOTTOM].push(legend);



    </script>


</body>
</html>
