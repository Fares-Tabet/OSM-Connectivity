        <figure>
            <img id="top" src="https://www.intechnic.com/hs-fs/hubfs/intechnic_2017/assets/images/landing/footer/map-xl.jpg?width=1680&height=824&name=map-xl.jpg" alt="backgroud image">
            <figcaption><h1>OSM Connectivity Project</h1></figcaption>
        </figure>
        <nav>
            <ul>
                <li><a href="#countries">Countries</a></li>
                <li><a href="#about">About</a></li>
