        </nav>
    </header>
    <section id="main">
        <header id="countries">
            <h2>Explore Countries</h2>
            <div class="row">
                <div class="col-sm-6">
                    <button class="btn btn-1" onclick="location.href='../NewZealand'">
                        <i class="flag-icon flag-icon-nz"></i>New Zealand
                    </button>
                </div>
                <div class="col-sm-6">
                    <button class="btn btn-2" onclick="location.href='../Fiji'">
                        <i class="flag-icon flag-icon-fj"></i> Fiji
                    </button>
                </div>
            </div>
        </header>

        <footer id="ende">
            @*<h4>Footer</h4>*@
        </footer>
    </section>
    <section id="image">
        <figure>
            <img src="https://cdn.hipwallpaper.com/i/18/45/lLdWeJ.jpg" alt="backgroud image">
            <figcaption>
                <a href="#about">&#8675;</a>
            </figcaption>
        </figure>
    </section>
    <section id="main">
        <header id="about">
            <h2>About</h2>
            <p style="position:center;">
                This project's goal is to detect disconnection and incorrect connections in the road network of any OSM region
                and to suggest fixes to achieves connectivity of different road networks.
            </p>
        </header>
        <footer>
            @*<h4>footer</h4>*@
        </footer>
    </section>
