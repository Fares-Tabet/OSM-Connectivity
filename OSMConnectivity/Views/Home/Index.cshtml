        function drawDisconnections() {

            @using Newtonsoft.Json;
            var json = @Html.Raw(JsonConvert.SerializeObject(ViewBag.disjointedSubTreeWays));
            var count = Object.keys(json).length;


            for (var i = 0; i < count; i++) {
                var data = [];
                var ptsCount = Object.keys(json[i]['nodes']).length;


                for (var j = 0; j < ptsCount; j++)
                {
                    data.push({ lat: json[i]['nodes'][j]['Lat'], lng: json[i]['nodes'][j]['Lng'] });
                }

                var flightPath = new google.maps.Polyline({
                    path: data,
                    geodesic: true,
                        strokeColor: json[i]['colorCode'],
                    strokeOpacity: 1.0,
                    strokeWeight: 2
                });
                disconnectionsLine.push(flightPath);
            }
            if (!undrawDisconnections) {
                for (i = 0; i < disconnectionsLine.length; i++) {
                    disconnectionsLine[i].setMap(map);
                }
                undrawDisconnections = true;
            } else {
                for (i = 0; i < disconnectionsLine.length; i++) {
                    disconnectionsLine[i].setMap(null);
                }
                undrawDisconnections = false;
            }

        }

